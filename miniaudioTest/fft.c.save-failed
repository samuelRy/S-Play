#define pi M_PI
#define forV(x) for(int x=0; x<n; x++)
#define forVN(x, n) for(int x=0; x<n; x++)
#define ARRAY_LEN(x) sizeof(x) / sizeof(x[0])
#define MIN(a, b) (a<b)? a : b
#define MAX(a, b) (a>b)? a : b
#define SPACE 32
#define ESCAPE 27
#define RIGHT 77
#define LEFT 75
#define UP 72
#define DOWN 80

void fft(int sampleSize, complex float* samples, complex float*outPut);
ma_uint32 frames[4410];
int frameC;
ma_result result;
ma_decoder decoder;
ma_device_config deviceConfig;
ma_device device;
ma_uint64 cursor;
ma_uint64 length;
bool br = true;

